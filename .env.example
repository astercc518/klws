# 复制为 .env 并填入真实值(.env 已被 gitignore)。本机可由 /etc/klws/backend.env 派生:
#   sed 's#localhost:5433#postgres:5432#g' /etc/klws/backend.env > .env
#   sed -i 's#^WADIST_REDIS_ADDR=.*#WADIST_REDIS_ADDR=redis:6379#' .env

# —— 数据库(指向 compose 服务名)——
WADIST_POSTGRES_DSN=postgres://app:app@postgres:5432/wadist?sslmode=disable
WADIST_APP_TENANT_DSN=postgres://app_tenant:CHANGEME@postgres:5432/wadist?sslmode=disable
WADIST_APP_SYSTEM_DSN=postgres://app_system:CHANGEME@postgres:5432/wadist?sslmode=disable
WADIST_REDIS_ADDR=redis:6379

# —— 密钥(base64-std,>=32 字节;勿提交真实值)——
WADIST_MASTER_KEY=CHANGEME_base64_32B
WADIST_BLIND_INDEX_KEY=CHANGEME_base64_32B
WADIST_CONSOLE_SESSION_KEY=CHANGEME_base64_32B

# —— Web 层 ——
WADIST_CONSOLE_ADDR=:8080
WADIST_CONSOLE_COOKIE_SECURE=true
# 受保护的超级/引导管理员登录标识(逗号分隔,email 或用户名);这些账号从
# 用户管理列表隐藏,且编辑/禁用/重置密码端点对其返回 403。留空=不保护任何账号。
WADIST_PROTECTED_ADMINS=
